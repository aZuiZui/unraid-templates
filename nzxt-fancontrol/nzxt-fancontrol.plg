<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "nzxt-fancontrol">
<!ENTITY author    "aZuiZui">
<!ENTITY version   "2026.10.17e">
<!ENTITY launch    "Settings/NZXTFanControl">
<!ENTITY pluginURL "https://raw.githubusercontent.com/aZuiZui/unraid-templates/main/nzxt-fancontrol/nzxt-fancontrol.plg">
<!ENTITY support   "https://github.com/aZuiZui/unraid-templates/issues">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="&support;" min="6.12.0" icon="snowflake-o">

<CHANGES>
###2026.10.17e
- Fail-safe: a fan whose sensor can't be read runs at the safe speed
- Controller USB drops are detected and recovered, with Unraid notifications
- Notification when a fan stops (0 RPM); cron watchdog restarts the daemon
- Fan 3 is never slower than fan 2 above the NVMe temperature (was: copied fan 2 even when lower)
- Hottest-drive temperature mode (default) alongside average
- Fan names, Identify button, PWM/DC mode shown, Dashboard tile, plugin icon
- Settings Apply reloads in place (no blip to the safe speed); quieter syslog

###2026.10.17d
- Fan curve editor: one row per step (temperature and fan speed), add/remove/reset
- Fan speed now ramps linearly between curve points instead of jumping in steps
- "Cool and quiet" preset button that fills in a curve for every fan
- Live curve chart per fan with the current temperature and speed marked

###2026.10.17
- Initial release: replaces the minimal-liquidctl Docker container
- Uses the in-kernel nzxt-smart2 driver (no liquidctl / Python / Docker)
- HDD temps from Unraid disk status, so spun-down drives are never woken
- Settings page with live fan status
</CHANGES>

<!-- Stop a running daemon before files are replaced (upgrade). -->
<FILE Run="/bin/bash">
<INLINE>
[ -x &emhttp;/scripts/rc.&name; ] &amp;&amp; &emhttp;/scripts/rc.&name; stop
rm -rf &emhttp;
exit 0
</INLINE>
</FILE>

<FILE Name="&emhttp;/default.cfg">
<INLINE><![CDATA[SERVICE="enable"
INTERVAL="60"
FAN1_NAME="HDD fan"
FAN2_NAME="NVMe fan"
FAN3_NAME="Case fan"
HDD_TEMP_MODE="max"
HDD_THRESHOLDS="30,35,40,45,50"
FAN1_SPEEDS="20,30,40,50,100"
HDD_IDLE_SPEED="0"
EXCLUDED_DRIVES=""
NVME_THRESHOLDS="30,35,40,45,50"
FAN2_SPEEDS="10,20,50,70,100"
MB_SENSOR="acpitz"
MB_THRESHOLDS="30,35,40,45,50"
FAN3_SPEEDS="20,25,30,40,100"
FAN3_FOLLOW_NVME_ABOVE="40"
FAN_QUANTITY="3"
STOP_SPEED="60"
NOTIFY="yes"
DASHBOARD="yes"
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/NZXTFanControl.page">
<INLINE><![CDATA[Menu="Utilities"
Title="NZXT Fan Control"
Icon="snowflake-o"
Tag="snowflake-o"
---
<?PHP
$plugin = "nzxt-fancontrol";
$cfg = parse_plugin_cfg($plugin);
$defaults = parse_ini_file("/usr/local/emhttp/plugins/$plugin/default.cfg");
$running = trim(shell_exec("/usr/local/emhttp/plugins/$plugin/scripts/rc.$plugin status 2>/dev/null"));
?>
<style>
#nzxt{--nz-series:#2a78d6;--nz-grid:rgba(128,128,128,.22);--nz-muted:rgba(128,128,128,.95);--nz-border:rgba(128,128,128,.3);--nz-bad:#d03b3b}
#nzxt.nz-dark{--nz-series:#3987e5;--nz-bad:#e66767}
#nzxt .nz-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,560px),1fr));gap:16px;margin:12px 0 20px}
#nzxt .nz-card{border:1px solid var(--nz-border);border-radius:6px;padding:12px 14px}
#nzxt .nz-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:4px 12px;margin-bottom:8px}
#nzxt .nz-title{font-weight:bold;font-size:1.15em}
#nzxt .nz-live{color:var(--nz-muted);font-variant-numeric:tabular-nums}
#nzxt .nz-live b{color:inherit}
#nzxt .nz-body{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:flex-start}
#nzxt table.nz-steps{width:auto;margin:0;border-collapse:collapse}
#nzxt table.nz-steps th{font-weight:normal;color:var(--nz-muted);text-align:left;padding:0 6px 4px 0;white-space:nowrap}
#nzxt table.nz-steps td{padding:2px 6px 2px 0;white-space:nowrap;border:0}
#nzxt table.nz-steps input[type=number]{width:62px!important;min-width:0!important;margin:0!important;padding:3px 4px!important;text-align:right}
#nzxt table.nz-steps input.nz-invalid{outline:2px solid var(--nz-bad)}
#nzxt .nz-x{min-width:0!important;margin:0!important;padding:2px 8px!important}
#nzxt .nz-actions{margin-top:6px}
#nzxt .nz-actions input{margin:0 6px 0 0!important}
#nzxt .nz-hint{color:var(--nz-muted);font-size:.9em;margin-top:6px;max-width:240px}
#nzxt .nz-chart{position:relative;flex:1 1 300px;min-width:260px}
#nzxt svg{display:block;width:100%;height:auto;overflow:visible}
#nzxt svg text{fill:currentColor;font-size:11px}
#nzxt svg .nz-axis text{fill:var(--nz-muted)}
#nzxt .nz-tip{position:absolute;pointer-events:none;padding:3px 7px;border-radius:4px;border:1px solid var(--nz-border);background:var(--nz-surface,#fff);white-space:nowrap;font-size:12px;display:none;transform:translate(-50%,-130%)}
#nzxt .nz-error{color:var(--nz-bad);margin-top:4px}
#nzxt .nz-presets{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin-top:12px}
#nzxt .nz-presets input{margin:0!important}
#nzxt .nz-presets span{color:var(--nz-muted)}
#nzxt .nz-title{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
#nzxt .nz-title input{width:170px!important;min-width:0!important;margin:0!important;padding:2px 6px!important;font-weight:bold;font-size:1em}
#nzxt .nz-sub{color:var(--nz-muted);font-weight:normal;font-size:.9em}
#nzxt .nz-note{display:block;color:var(--nz-muted);font-size:.9em;margin-top:2px;text-align:right}
#nzxt .nz-warn{color:var(--nz-bad)}
</style>

<div id="nzxt">
<p><b>Status:</b> <span id="nz-state"><?=htmlspecialchars($running)?></span></p>

<form markdown="1" name="nzxt_settings" method="POST" action="/update.php" target="progressFrame" onsubmit="return nzSubmit(this)">
<input type="hidden" name="#file" value="<?=$plugin?>/<?=$plugin?>.cfg">
<input type="hidden" name="#command" value="/plugins/<?=$plugin?>/scripts/rc.<?=$plugin?>">
<input type="hidden" name="#arg[1]" value="apply">
<?foreach (['HDD_THRESHOLDS','FAN1_SPEEDS','NVME_THRESHOLDS','FAN2_SPEEDS','MB_THRESHOLDS','FAN3_SPEEDS'] as $key):?>
<input type="hidden" name="<?=$key?>" value="<?=htmlspecialchars($cfg[$key])?>" data-default="<?=htmlspecialchars($defaults[$key])?>">
<?endforeach;?>

<div class="nz-presets">
<input type="button" value="Cool &amp; quiet" onclick="nzPreset('quiet')" title="Quiet in the normal range, full speed before Unraid's temperature warnings">
<span id="nz-preset-note">Fills in a curve for every fan. Nothing changes until you click Apply.</span>
</div>

<div class="nz-cards" id="nz-cards"></div>

<h3>Fan rules</h3>

Drive temperature used:
: <select name="HDD_TEMP_MODE">
  <?=mk_option($cfg['HDD_TEMP_MODE'], "max", "Hottest drive")?>
  <?=mk_option($cfg['HDD_TEMP_MODE'], "avg", "Average of all drives")?>
  </select>

> Applies to both the hard drives (fan 1) and the NVMe drives (fan 2). "Hottest drive" stops one hot drive hiding behind cool ones.

Fan 1 speed when all drives are spun down (%):
: <input type="number" name="HDD_IDLE_SPEED" min="0" max="100" value="<?=$cfg['HDD_IDLE_SPEED']?>" class="narrow">

Excluded drives:
: <input type="text" name="EXCLUDED_DRIVES" value="<?=$cfg['EXCLUDED_DRIVES']?>" placeholder="e.g. sdb,disk5">

> HDD temperatures come from Unraid's own disk status, so spun-down drives are never woken.
> Exclude drives by device (sdb) or array slot (parity, disk5), comma-separated.

Fan 3 at least as fast as fan 2 above NVMe temp (&deg;C):
: <input type="number" name="FAN3_FOLLOW_NVME_ABOVE" min="0" max="100" value="<?=$cfg['FAN3_FOLLOW_NVME_ABOVE']?>" class="narrow">

> Leave empty to disable.

Motherboard sensor (hwmon name):
: <input type="text" name="MB_SENSOR" value="<?=$cfg['MB_SENSOR']?>" class="narrow">

<h3>Service</h3>

Fan control service:
: <select name="SERVICE">
  <?=mk_option($cfg['SERVICE'], "enable", "Enabled")?>
  <?=mk_option($cfg['SERVICE'], "disable", "Disabled")?>
  </select>

Number of fans:
: <select name="FAN_QUANTITY" onchange="nzShowCards()">
  <?=mk_option($cfg['FAN_QUANTITY'], "1", "1")?>
  <?=mk_option($cfg['FAN_QUANTITY'], "2", "2")?>
  <?=mk_option($cfg['FAN_QUANTITY'], "3", "3")?>
  </select>

Check interval (seconds):
: <input type="number" name="INTERVAL" min="5" max="600" value="<?=$cfg['INTERVAL']?>" class="narrow">

Safe speed (%):
: <input type="number" name="STOP_SPEED" min="0" max="100" value="<?=$cfg['STOP_SPEED']?>" class="narrow">

> Used when the service stops and for any fan whose temperature sensor can't be read.

Notifications:
: <select name="NOTIFY">
  <?=mk_option($cfg['NOTIFY'], "yes", "Yes")?>
  <?=mk_option($cfg['NOTIFY'], "no", "No")?>
  </select>

> Unraid notifications when a fan stops, the controller goes missing, or the watchdog restarts the service.

Dashboard tile:
: <select name="DASHBOARD">
  <?=mk_option($cfg['DASHBOARD'], "yes", "Show")?>
  <?=mk_option($cfg['DASHBOARD'], "no", "Hide")?>
  </select>

&nbsp;
: <input type="submit" value="Apply"><input type="button" value="Done" onclick="done()">
</form>
</div>

<script>
var nzFans = [
  {n:1, sub:'Fan 1, follows the array hard drives', t:'HDD_THRESHOLDS', s:'FAN1_SPEEDS', name:<?=json_encode($cfg['FAN1_NAME'])?>},
  {n:2, sub:'Fan 2, follows the NVMe drives', t:'NVME_THRESHOLDS', s:'FAN2_SPEEDS', name:<?=json_encode($cfg['FAN2_NAME'])?>},
  {n:3, sub:'Fan 3, follows the motherboard', t:'MB_THRESHOLDS', s:'FAN3_SPEEDS', name:<?=json_encode($cfg['FAN3_NAME'])?>}
];
var nzLive = {};
// [temp, speed] points. Quiet through normal temps, full speed by Unraid's default warnings (HDD 51, SSD 60-70).
var nzPresets = {
  quiet: {name: 'Cool & quiet', 1: [[35,20],[40,30],[44,45],[48,75],[51,100]], 2: [[40,10],[50,25],[60,60],[70,100]], 3: [[30,20],[38,30],[45,60],[55,100]]}
};

function nzPreset(key) {
  var p = nzPresets[key];
  nzFans.forEach(function(fan) {
    fan.steps = p[fan.n].map(function(pt){ return {t: pt[0], s: pt[1]}; });
    nzRenderRows(fan); nzDraw(fan);
  });
  $('#nz-preset-note').text(p.name + ' curves filled in. Click Apply to save them.');
}
var NS = 'http://www.w3.org/2000/svg';
var W = 380, H = 190, M = {l:34, r:12, t:12, b:28};

function nzList(v) { return String(v || '').split(',').map(function(x){ return parseInt(x, 10); }).filter(function(x){ return !isNaN(x); }); }
function nzHidden(name) { return document.querySelector('#nzxt input[type=hidden][name="' + name + '"]'); }

function nzLoad(fan, useDefault) {
  var t = nzHidden(fan.t), s = nzHidden(fan.s);
  var ts = nzList(useDefault ? t.dataset.default : t.value), ss = nzList(useDefault ? s.dataset.default : s.value);
  fan.steps = ts.map(function(temp, i){ return {t: temp, s: ss[i] !== undefined ? ss[i] : ss[ss.length - 1] || 0}; });
  if (!fan.steps.length) fan.steps = [{t: 30, s: 30}];
}

// Same rule as the daemon: linear ramp between points, first/last speed outside them.
function nzSpeedAt(steps, temp) {
  var p = steps.slice().sort(function(a, b){ return a.t - b.t; });
  if (temp <= p[0].t) return p[0].s;
  for (var i = 1; i < p.length; i++)
    if (temp < p[i].t) return p[i-1].s + Math.trunc((p[i].s - p[i-1].s) * (temp - p[i-1].t) / (p[i].t - p[i-1].t));
  return p[p.length - 1].s;
}

function el(tag, attrs, parent) {
  var e = tag.indexOf('svg:') === 0 ? document.createElementNS(NS, tag.slice(4)) : document.createElement(tag);
  for (var k in attrs || {}) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
}

function nzBuildCard(fan) {
  var card = el('div', {'class': 'nz-card', id: 'nz-fan' + fan.n});
  var head = el('div', {'class': 'nz-head'}, card);
  var title = el('span', {'class': 'nz-title'}, head);
  var name = el('input', {type: 'text', name: 'FAN' + fan.n + '_NAME', maxlength: 24, pattern: '[^"|\\\\$`]*', title: 'Fan name', 'aria-label': 'Fan ' + fan.n + ' name'}, title);
  name.value = fan.name || ('Fan ' + fan.n);
  el('span', {'class': 'nz-sub'}, title).textContent = fan.sub;
  var liveBox = el('span', {}, head);
  fan.liveEl = el('span', {'class': 'nz-live'}, liveBox);
  fan.noteEl = el('span', {'class': 'nz-note'}, liveBox);
  var body = el('div', {'class': 'nz-body'}, card);
  var left = el('div', {}, body);
  var table = el('table', {'class': 'nz-steps'}, left);
  el('thead', {}, table).innerHTML = '<tr><th>Temp &deg;C</th><th>Fan %</th><th></th></tr>';
  fan.tbody = el('tbody', {}, table);
  var actions = el('div', {'class': 'nz-actions'}, left);
  var add = el('input', {type: 'button', value: '+ Add point'}, actions);
  add.onclick = function(){ nzAddStep(fan); };
  var reset = el('input', {type: 'button', value: 'Reset to default'}, actions);
  reset.onclick = function(){ nzLoad(fan, true); nzRenderRows(fan); nzDraw(fan); };
  var ident = el('input', {type: 'button', value: 'Identify', title: 'Run this fan at 100% for 10 seconds so you can see which one it is'}, actions);
  ident.onclick = function(){ nzIdentify(fan, ident); };
  fan.errEl = el('div', {'class': 'nz-error'}, left);
  el('div', {'class': 'nz-hint'}, left).textContent = 'The fan ramps evenly between points, and holds the first and last speed outside them.';
  var chart = el('div', {'class': 'nz-chart'}, body);
  fan.svg = el('svg:svg', {viewBox: '0 0 ' + W + ' ' + H, role: 'img'}, chart);
  fan.tip = el('div', {'class': 'nz-tip'}, chart);
  fan.svg.addEventListener('mousemove', function(e){ nzHover(fan, e); });
  fan.svg.addEventListener('mouseleave', function(){ fan.tip.style.display = 'none'; if (fan.cross) fan.cross.style.display = 'none'; });
  return card;
}

function nzRenderRows(fan) {
  fan.tbody.innerHTML = '';
  fan.steps.forEach(function(step, i) {
    var tr = el('tr', {}, fan.tbody);
    var t = el('input', {type: 'number', min: 0, max: 100, value: step.t, 'aria-label': 'Temperature'}, el('td', {}, tr));
    var s = el('input', {type: 'number', min: 0, max: 100, step: 5, value: step.s, 'aria-label': 'Fan speed'}, el('td', {}, tr));
    var x = el('input', {type: 'button', value: '×', title: 'Remove point', 'class': 'nz-x'}, el('td', {}, tr));
    x.disabled = fan.steps.length < 2;
    t.oninput = function(){ step.t = parseInt(t.value, 10); nzDraw(fan); };
    s.oninput = function(){ step.s = Math.max(0, Math.min(100, parseInt(s.value, 10) || 0)); nzDraw(fan); };
    x.onclick = function(){ fan.steps.splice(i, 1); nzRenderRows(fan); nzDraw(fan); };
    step.tEl = t;
  });
}

function nzAddStep(fan) {
  var last = fan.steps.reduce(function(a, b){ return b.t > a.t ? b : a; });
  fan.steps.push({t: Math.min(100, last.t + 5), s: Math.min(100, last.s + 10)});
  nzRenderRows(fan); nzDraw(fan);
}

function nzValidate(fan) {
  var seen = {}, msg = '';
  fan.steps.forEach(function(st){ st.tEl && st.tEl.classList.remove('nz-invalid'); });
  fan.steps.forEach(function(st) {
    if (isNaN(st.t)) { msg = 'Every point needs a temperature.'; st.tEl && st.tEl.classList.add('nz-invalid'); }
    else if (seen[st.t]) { msg = 'Two points use ' + st.t + '°C.'; st.tEl && st.tEl.classList.add('nz-invalid'); seen[st.t].tEl && seen[st.t].tEl.classList.add('nz-invalid'); }
    seen[st.t] = st;
  });
  fan.errEl.textContent = msg;
  return !msg;
}

function nzDraw(fan) {
  var svg = fan.svg; svg.innerHTML = '';
  if (!nzValidate(fan)) return;
  var steps = fan.steps.slice().sort(function(a, b){ return a.t - b.t; });
  var live = nzLive[fan.n] && nzLive[fan.n].temp !== null ? nzLive[fan.n] : null;
  var lo = Math.min(20, steps[0].t - 5), hi = Math.max(60, steps[steps.length - 1].t + 10);
  if (live) { lo = Math.min(lo, live.temp - 5); hi = Math.max(hi, live.temp + 5); }
  lo = Math.floor(lo / 10) * 10; hi = Math.ceil(hi / 10) * 10;
  var x = function(v){ return M.l + (v - lo) / (hi - lo) * (W - M.l - M.r); };
  var y = function(v){ return H - M.b - v / 100 * (H - M.t - M.b); };
  fan.scale = {x: x, lo: lo, hi: hi, steps: steps};

  var axis = el('svg:g', {'class': 'nz-axis'}, svg);
  [0, 25, 50, 75, 100].forEach(function(v) {
    el('svg:line', {x1: M.l, x2: W - M.r, y1: y(v), y2: y(v), stroke: 'var(--nz-grid)', 'stroke-width': 1}, axis);
    el('svg:text', {x: M.l - 6, y: y(v) + 4, 'text-anchor': 'end'}, axis).textContent = v + '%';
  });
  for (var v = lo; v <= hi; v += 10)
    el('svg:text', {x: x(v), y: H - M.b + 16, 'text-anchor': 'middle'}, axis).textContent = v + '°';

  var d = 'M' + x(lo) + ',' + y(steps[0].s);
  steps.forEach(function(st){ d += 'L' + x(st.t) + ',' + y(st.s); });
  d += 'H' + x(hi);
  el('svg:path', {d: d, fill: 'none', stroke: 'var(--nz-series)', 'stroke-width': 2, 'stroke-linejoin': 'round'}, svg);
  steps.forEach(function(st) {
    el('svg:circle', {cx: x(st.t), cy: y(st.s), r: 4, fill: 'var(--nz-series)', stroke: 'var(--nz-surface,#fff)', 'stroke-width': 2}, svg);
  });

  fan.cross = el('svg:line', {y1: M.t, y2: H - M.b, stroke: 'var(--nz-muted)', 'stroke-width': 1, style: 'display:none'}, svg);

  if (live) {
    var lx = x(live.temp), ly = y(live.speed);
    el('svg:line', {x1: lx, x2: lx, y1: M.t, y2: H - M.b, stroke: 'currentColor', 'stroke-width': 1, opacity: .45}, svg);
    el('svg:circle', {cx: lx, cy: ly, r: 6, fill: 'currentColor', stroke: 'var(--nz-surface,#fff)', 'stroke-width': 2}, svg);
    var right = lx > W - 90;
    el('svg:text', {x: lx + (right ? -10 : 10), y: Math.max(M.t + 10, ly - 10), 'text-anchor': right ? 'end' : 'start', 'font-weight': 'bold'}, svg)
      .textContent = 'now ' + live.temp + '° → ' + live.speed + '%';
  }
  svg.setAttribute('aria-label', fan.title + ' curve: ' + steps.map(function(s){ return s.t + '°C ' + s.s + '%'; }).join(', '));
}

function nzHover(fan, e) {
  if (!fan.scale) return;
  var r = fan.svg.getBoundingClientRect(), px = (e.clientX - r.left) / r.width * W;
  if (px < M.l || px > W - M.r) { fan.tip.style.display = 'none'; fan.cross.style.display = 'none'; return; }
  var s = fan.scale, temp = Math.round(s.lo + (px - M.l) / (W - M.l - M.r) * (s.hi - s.lo));
  var sx = s.x(temp);
  fan.cross.setAttribute('x1', sx); fan.cross.setAttribute('x2', sx); fan.cross.style.display = '';
  fan.tip.textContent = temp + '°C → ' + nzSpeedAt(s.steps, temp) + '%';
  fan.tip.style.left = (sx / W * r.width) + 'px';
  fan.tip.style.top = (M.t / H * r.height + 14) + 'px';
  fan.tip.style.display = 'block';
}

function nzShowCards() {
  var n = parseInt(document.querySelector('#nzxt select[name=FAN_QUANTITY]').value, 10);
  nzFans.forEach(function(fan){ fan.card.style.display = fan.n <= n ? '' : 'none'; });
}

function nzSubmit(form) {
  var ok = true;
  nzFans.forEach(function(fan) {
    if (!nzValidate(fan)) { ok = false; return; }
    var steps = fan.steps.slice().sort(function(a, b){ return a.t - b.t; });
    nzHidden(fan.t).value = steps.map(function(s){ return s.t; }).join(',');
    nzHidden(fan.s).value = steps.map(function(s){ return s.s; }).join(',');
    fan.steps = steps; nzRenderRows(fan); nzDraw(fan);
  });
  return ok;
}

function nzIdentify(fan, btn) {
  btn.disabled = true; btn.value = 'Spinning...';
  $.post('/plugins/nzxt-fancontrol/include/action.php', {action: 'identify', fan: fan.n, csrf_token: csrf_token}, function(r) {
    if (!r.ok) $(fan.noteEl).text(r.msg).addClass('nz-warn');
    setTimeout(nzRefresh, 500);
  }, 'json').always(function() {
    setTimeout(function(){ btn.disabled = false; btn.value = 'Identify'; nzRefresh(); }, 10500);
  });
}

function nzRefresh() {
  $.get('/plugins/nzxt-fancontrol/include/status.php', function(data) {
    $('#nz-state').text(data.controller === 'missing' ? 'NZXT controller not found. Check its USB cable; control resumes when it is back.' : data.state)
      .toggleClass('nz-warn', data.controller === 'missing');
    nzLive = {};
    (data.fans || []).forEach(function(f) { nzLive[f.fan] = f; });
    nzFans.forEach(function(fan) {
      var f = nzLive[fan.n];
      fan.liveEl.innerHTML = f ? f.source + ' <b>' + (f.temp === null ? '?' : f.temp + '&deg;C') + '</b> &middot; <b>' + f.speed + '%</b> &middot; ' + f.rpm + ' RPM &middot; ' + f.mode : 'no data';
      var note = f ? f.note : '';
      if (f && f.mode === 'DC' && !note) note = 'DC (3-pin) fan: the controller varies voltage, so its speed range may be narrow';
      $(fan.noteEl).text(note).toggleClass('nz-warn', !!(f && /stopped|safe speed/.test(f.note)));
      nzDraw(fan);
    });
  }, 'json');
}

// Pick dark-mode steps from the actual Unraid theme background.
function nzTheme() {
  var bg = [255, 255, 255];
  for (var node = document.getElementById('nzxt'); node; node = node.parentElement) {
    var c = getComputedStyle(node).backgroundColor.match(/[\d.]+/g);
    if (c && (c.length < 4 || +c[3] > 0)) { bg = c; break; }
  }
  var lum = (0.299 * bg[0] + 0.587 * bg[1] + 0.114 * bg[2]) / 255;
  var root = document.getElementById('nzxt');
  root.classList.toggle('nz-dark', lum < 0.5);
  root.style.setProperty('--nz-surface', 'rgb(' + bg.slice(0, 3).join(',') + ')');
}

$(function() {
  nzTheme();
  var cards = document.getElementById('nz-cards');
  nzFans.forEach(function(fan) {
    nzLoad(fan);
    fan.card = nzBuildCard(fan);
    cards.appendChild(fan.card);
    nzRenderRows(fan);
    nzDraw(fan);
  });
  nzShowCards();
  nzRefresh();
  setInterval(nzRefresh, 5000);
});
</script>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/NZXTFanDash.page">
<INLINE><![CDATA[Menu="Dashboard:0"
Cond="(@parse_ini_file('/boot/config/plugins/nzxt-fancontrol/nzxt-fancontrol.cfg')['DASHBOARD'] ?? 'yes') != 'no'"
---
<?PHP
$pluginname = "nzxt-fancontrol";

$mytiles[$pluginname]['column2'] =
<<<EOT
<tbody id="nzdash" title="_(NZXT Fan Control)_">
<tr>
  <td>
    <span class='tile-header'>
      <span class='tile-header-left'>
        <i class='fa fa-snowflake-o f32'></i>
        <div class='section'>
          <h3 class='tile-header-main'>_(Fans)_</h3>
          <span id='nzdash-state'>_(Loading)_...</span><br>
        </div>
      </span>
      <span class='tile-header-right'>
        <span class='tile-header-right-controls'>
          <a href="/Settings/NZXTFanControl" title="_(Fan control settings)_"><i class="fa fa-fw fa-cog control"></i></a>
        </span>
      </span>
    </span>
  </td>
</tr>
<tr><td id="nzdash-fans"></td></tr>
</tbody>
EOT;
?>
<style>
#nzdash-fans .nzd-row{display:grid;grid-template-columns:minmax(0,1fr) 3.5em 7em 5em;align-items:center;gap:8px;padding:3px 0;font-variant-numeric:tabular-nums}
#nzdash-fans .nzd-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#nzdash-fans .nzd-bar{position:relative;height:14px;border-radius:3px;background:rgba(128,128,128,.2);overflow:hidden}
#nzdash-fans .nzd-bar span{position:absolute;inset:0 auto 0 0;background:#3987e5;border-radius:3px}
#nzdash-fans .nzd-bar b{position:relative;display:block;text-align:center;font-size:11px;line-height:14px;font-weight:normal}
#nzdash-fans .nzd-rpm,#nzdash-fans .nzd-temp{text-align:right}
#nzdash-fans .nzd-note{grid-column:1/-1;opacity:.75;font-size:.9em;margin-top:-2px}
</style>
<script>
function nzDashRefresh() {
  $.get('/plugins/nzxt-fancontrol/include/status.php', function(d) {
    var box = $('#nzdash-fans');
    if (!box.length) return;
    $('#nzdash-state').text(d.controller === 'missing' ? 'Controller missing' : (d.fans.length ? 'Running' : 'Stopped'));
    box.html(d.fans.map(function(f) {
      return '<div class="nzd-row"><span class="nzd-name" title="' + f.source + '">' + f.name + '</span>' +
        '<span class="nzd-temp">' + (f.temp === null ? '-' : f.temp + '&deg;C') + '</span>' +
        '<span class="nzd-bar"><span style="width:' + f.speed + '%"></span><b>' + f.speed + '%</b></span>' +
        '<span class="nzd-rpm">' + f.rpm + ' rpm</span>' +
        (f.note ? '<span class="nzd-note">' + f.note + '</span>' : '') + '</div>';
    }).join('') || '<span class="nzd-note">No data</span>');
  }, 'json');
}
$(function() {
  nzDashRefresh();
  setInterval(nzDashRefresh, 10000);
});
</script>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/status.php">
<INLINE><![CDATA[<?PHP
$plugin = "nzxt-fancontrol";
$status = @parse_ini_file("/var/run/$plugin.status") ?: [];
$state = trim(shell_exec("/usr/local/emhttp/plugins/$plugin/scripts/rc.$plugin status 2>/dev/null"));

$fans = [];
for ($fan = 1; $fan <= 3; $fan++) {
  if (!isset($status["fan$fan"])) continue;
  [$name, $source, $temp, $speed, $rpm, $mode, $note] = array_pad(explode("|", $status["fan$fan"]), 7, "");
  $fans[] = [
    'fan' => $fan, 'name' => htmlspecialchars($name), 'source' => htmlspecialchars($source),
    'temp' => is_numeric($temp) ? (int)$temp : null, 'speed' => (int)$speed, 'rpm' => (int)$rpm,
    'mode' => htmlspecialchars($mode), 'note' => htmlspecialchars($note),
  ];
}
if (isset($status['updated'])) $state .= " - updated ".$status['updated'];

header('Content-Type: application/json');
echo json_encode(['state' => $state, 'controller' => $status['controller'] ?? '', 'fans' => $fans]);
?>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/action.php">
<INLINE><![CDATA[<?PHP
// POST only; Unraid's request prepend checks csrf_token.
$plugin = "nzxt-fancontrol";
$fan = (int)($_POST['fan'] ?? 0);
header('Content-Type: application/json');
if (($_POST['action'] ?? '') !== 'identify' || $fan < 1 || $fan > 3) {
  http_response_code(400);
  echo json_encode(['ok' => false, 'msg' => 'bad request']);
  return;
}
exec("/usr/local/emhttp/plugins/$plugin/scripts/rc.$plugin identify $fan 2>&1", $out, $rc);
echo json_encode(['ok' => $rc === 0, 'msg' => implode(' ', $out)]);
?>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/fancontrol.sh" Mode="0755">
<INLINE><![CDATA[#!/bin/bash
# NZXT RGB & Fan Controller daemon for Unraid.
# Fan1 -> HDD, Fan2 -> NVMe, Fan3 -> motherboard.
# Talks to the in-kernel nzxt-smart2 hwmon driver; no liquidctl needed.

PLUGIN=nzxt-fancontrol
DEFAULT_CFG=/usr/local/emhttp/plugins/$PLUGIN/default.cfg
USER_CFG=/boot/config/plugins/$PLUGIN/$PLUGIN.cfg
DISKS_INI=/var/local/emhttp/disks.ini
STATUS=/var/run/$PLUGIN.status
IDENTIFY=/var/run/$PLUGIN.identify
NOTIFY_CMD=/usr/local/emhttp/webGui/scripts/notify
LOG_STEP=5      # only log speed changes of at least this many %
STALL_TICKS=2   # consecutive 0 RPM readings before a fan counts as stopped

log() { logger -t "$PLUGIN" -- "$*"; }

notify() { # <normal|warning|alert> <subject> <description>
  log "$2: $3"
  [[ $NOTIFY == yes && -x $NOTIFY_CMD ]] && "$NOTIFY_CMD" -e "NZXT Fan Control" -i "$1" -s "$2" -d "$3" >/dev/null 2>&1
}

int_or() { [[ $1 =~ ^[0-9]+$ ]] && echo "$1" || echo "$2"; }
pct_or() { local v; v=$(int_or "$1" "$2"); echo $(( v > 100 ? 100 : v )); }
default_of() { ( source "$DEFAULT_CFG"; echo "${!1}" ); }

# Fills <NAME>_T / <NAME>_S with sorted, de-duplicated points, speeds clamped to 100.
parse_curve() { # <NAME> <temps> <speeds>
  local -n out_t=${1}_T out_s=${1}_S
  local t s
  out_t=() out_s=()
  while read -r t s; do
    [[ -n $t ]] && out_t+=("$t") out_s+=("$s")
  done < <(paste -d' ' <(tr ',' '\n' <<< "${2// /}") <(tr ',' '\n' <<< "${3// /}") |
    awk 'NF == 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && !seen[$1]++ { print $1, ($2 > 100 ? 100 : $2) }' | sort -n)
  (( ${#out_t[@]} > 0 ))
}

load_curve() { # <NAME> <temps key> <speeds key>
  parse_curve "$1" "${!2}" "${!3}" && return
  log "warning: $2/$3 has no valid points, using the default curve"
  parse_curve "$1" "$(default_of "$2")" "$(default_of "$3")"
}

load_config() {
  source "$DEFAULT_CFG"
  [[ -f $USER_CFG ]] && source "$USER_CFG"
  INTERVAL=$(int_or "$INTERVAL" 60); (( INTERVAL < 5 )) && INTERVAL=5
  FAN_QUANTITY=$(int_or "$FAN_QUANTITY" 3); (( FAN_QUANTITY < 1 || FAN_QUANTITY > 3 )) && FAN_QUANTITY=3
  STOP_SPEED=$(pct_or "$STOP_SPEED" 60)
  HDD_IDLE_SPEED=$(pct_or "$HDD_IDLE_SPEED" 0)
  [[ $FAN3_FOLLOW_NVME_ABOVE =~ ^[0-9]+$ ]] || FAN3_FOLLOW_NVME_ABOVE=""
  [[ $HDD_TEMP_MODE == avg ]] || HDD_TEMP_MODE=max
  load_curve HDD HDD_THRESHOLDS FAN1_SPEEDS
  load_curve NVME NVME_THRESHOLDS FAN2_SPEEDS
  load_curve MB MB_THRESHOLDS FAN3_SPEEDS
  NAMES=("" "${FAN1_NAME:-Fan 1}" "${FAN2_NAME:-Fan 2}" "${FAN3_NAME:-Fan 3}")
  NAMES=("${NAMES[@]//[\"|]/}")
}

hwmon_by_name() {
  local hw
  for hw in /sys/class/hwmon/hwmon*; do
    [[ $(< "$hw/name") == "$1" ]] && echo "$hw"
  done 2>/dev/null
}

# Linear ramp between curve points; holds the first/last speed outside them.
curve() {
  local temp=$1 i n
  local -n t=$2 s=$3
  n=${#t[@]}
  (( temp <= t[0] )) && { echo "${s[0]}"; return; }
  for (( i = 1; i < n; i++ )); do
    if (( temp < t[i] )); then
      echo $(( s[i-1] + (s[i] - s[i-1]) * (temp - t[i-1]) / (t[i] - t[i-1]) ))
      return
    fi
  done
  echo "${s[n-1]}"
}

# HDD temp from Unraid's own disk state (never wakes a drive), "-" when none is readable.
# Prints "<temp> <online> <standby>".
read_hdd() {
  local excluded=",${EXCLUDED_DRIVES// /},"
  awk -F'"' -v ex="$excluded" -v mode="$HDD_TEMP_MODE" '
    /^\[/ { flush(); name = dev = type = temp = down = ""; next }
    /^name=/     { name = $2 }
    /^device=/   { dev = $2 }
    /^type=/     { type = $2 }
    /^temp=/     { temp = $2 }
    /^spundown=/ { down = $2 }
    function flush() {
      if (dev !~ /^sd/ || type == "Flash") return
      if (index(ex, "," dev ",") || index(ex, "," name ",")) return
      if (down == "1") { standby++; return }
      if (temp ~ /^[0-9]+$/) { sum += temp; online++; if (temp + 0 > max) max = temp + 0 }
    }
    END {
      flush()
      t = online ? (mode == "avg" ? int(sum / online) : max) : "-"
      printf "%s %d %d\n", t, online, standby
    }
  ' "$DISKS_INI" 2>/dev/null || echo "- 0 0"
}

# Hottest NVMe drive (or average with HDD_TEMP_MODE=avg). Prints "<temp> <count>".
read_nvme() {
  local hw v sum=0 max=0 n=0
  for hw in $(hwmon_by_name nvme); do
    v=$(cat "$hw/temp1_input" 2>/dev/null)
    [[ $v =~ ^[0-9]+$ ]] || continue
    (( v /= 1000, sum += v, n++ ))
    (( v > max )) && max=$v
  done
  if (( n == 0 )); then echo "- 0"
  elif [[ $HDD_TEMP_MODE == avg ]]; then echo "$(( sum / n )) $n"
  else echo "$max $n"
  fi
}

read_mb() {
  local hw v
  hw=$(hwmon_by_name "$MB_SENSOR" | head -n1)
  v=$(cat "$hw/temp1_input" 2>/dev/null)
  [[ $v =~ ^-?[0-9]+$ ]] && echo $(( v / 1000 )) || echo "-"
}

set_fan() {
  local fan=$1 pct=$2
  local pwm=$(( (pct * 255 + 50) / 100 ))
  { [[ $(< "$NZXT/pwm${fan}_enable") == 1 ]] || echo 1 > "$NZXT/pwm${fan}_enable"
    echo "$pwm" > "$NZXT/pwm$fan"   # always write: read-back can be stale right after a reconnect
  } 2>/dev/null || { NZXT=""; return 1; }
}

find_controller() {
  NZXT=$(hwmon_by_name nzxtsmart2 | head -n1)
  if [[ -z $NZXT ]]; then
    modprobe nzxt-smart2 2>/dev/null
    NZXT=$(hwmon_by_name nzxtsmart2 | head -n1)
  fi
  [[ -n $NZXT ]]
}

# Re-finds the controller when it vanished (a USB reset renumbers hwmon); notifies once per outage.
check_controller() {
  [[ -n $NZXT && $(cat "$NZXT/name" 2>/dev/null) == nzxtsmart2 ]] && return 0
  if find_controller; then
    [[ -n $CONTROLLER_LOST ]] && notify normal "Controller back" "NZXT controller found again at $NZXT; fan control resumed."
    CONTROLLER_LOST=""
    return 0
  fi
  [[ -z $CONTROLLER_LOST ]] && notify alert "Controller missing" "NZXT controller (nzxtsmart2) not found. Fans run at the controller's own speed until it is back."
  CONTROLLER_LOST=1
  printf 'updated="%s"\ncontroller="missing"\n' "$(date '+%F %T')" > "$STATUS"
  return 1
}

# Prints "<fan> <seconds left>" while an identify request is active.
identify_active() {
  local fan until now
  [[ -f $IDENTIFY ]] || return 1
  read -r fan until < "$IDENTIFY"
  now=$(date +%s)
  if [[ $fan =~ ^[1-3]$ && $until =~ ^[0-9]+$ ]] && (( until > now )); then echo "$fan $(( until - now ))"; return 0; fi
  rm -f "$IDENTIFY"
  return 1
}

declare -A LOGGED STALL

tick() {
  check_controller || return
  local hdd_temp hdd_on hdd_sb nvme_temp nvme_n mb_temp id_fan id_left fan speed rpm mode note last
  local -a speeds temps sources notes
  read -r hdd_temp hdd_on hdd_sb <<< "$(read_hdd)"
  read -r nvme_temp nvme_n <<< "$(read_nvme)"
  mb_temp=$(read_mb)

  if [[ $hdd_temp != - ]]; then
    speeds[1]=$(curve "$hdd_temp" HDD_T HDD_S)
  elif (( hdd_sb > 0 )); then
    speeds[1]=$HDD_IDLE_SPEED notes[1]="all drives spun down"
  else
    speeds[1]=$STOP_SPEED notes[1]="no drive temperature, safe speed"
  fi
  if [[ $nvme_temp != - ]]; then
    speeds[2]=$(curve "$nvme_temp" NVME_T NVME_S)
  else
    speeds[2]=$STOP_SPEED notes[2]="no NVMe temperature, safe speed"
  fi
  if [[ $mb_temp != - ]]; then
    speeds[3]=$(curve "$mb_temp" MB_T MB_S)
  else
    speeds[3]=$STOP_SPEED notes[3]="no $MB_SENSOR temperature, safe speed"
  fi
  # Fan 3 never runs slower than fan 2 once the NVMe drives are warm.
  if [[ -n $FAN3_FOLLOW_NVME_ABOVE && $nvme_temp != - ]] && (( nvme_temp > FAN3_FOLLOW_NVME_ABOVE && speeds[2] > speeds[3] )); then
    speeds[3]=${speeds[2]} notes[3]="following NVMe fan"
  fi
  read -r id_fan id_left <<< "$(identify_active)"
  [[ -n $id_fan ]] && speeds[id_fan]=100 notes[id_fan]="identify (${id_left}s)"

  temps=("" "$hdd_temp" "$nvme_temp" "$mb_temp")
  sources=("" "HDD $HDD_TEMP_MODE ($hdd_on up, $hdd_sb down)" "NVMe $HDD_TEMP_MODE ($nvme_n)" "MB ($MB_SENSOR)")
  {
    echo "updated=\"$(date '+%F %T')\""
    echo "controller=\"ok\""
    for (( fan = 1; fan <= FAN_QUANTITY; fan++ )); do
      speed=${speeds[fan]} note=${notes[fan]}
      set_fan "$fan" "$speed" || { log "error: writing fan$fan failed, looking for the controller again"; return; }
      rpm=$(int_or "$(cat "$NZXT/fan${fan}_input" 2>/dev/null)" 0)
      [[ $(cat "$NZXT/pwm${fan}_mode" 2>/dev/null) == 1 ]] && mode=PWM || mode=DC

      if (( speed > 0 && rpm == 0 )); then
        (( ++STALL[$fan] == STALL_TICKS )) && notify warning "${NAMES[fan]} stopped" "Fan $fan is set to $speed% but reports 0 RPM. Check the fan and its cable."
        (( STALL[$fan] >= STALL_TICKS )) && note="stopped: 0 RPM"
      else
        (( ${STALL[$fan]:-0} >= STALL_TICKS )) && notify normal "${NAMES[fan]} spinning again" "Fan $fan reports $rpm RPM."
        STALL[$fan]=0
      fi

      last=${LOGGED[$fan]}
      if [[ -z $last ]] || (( speed - last >= LOG_STEP || last - speed >= LOG_STEP || (speed == 0) != (last == 0) )); then
        log "fan$fan (${NAMES[fan]}) -> $speed% (${sources[fan]} ${temps[fan]}C${note:+, $note})"
        LOGGED[$fan]=$speed
      fi
      echo "fan${fan}=\"${NAMES[fan]}|${sources[fan]}|${temps[fan]}|$speed|$rpm|$mode|$note\""
    done
  } > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

SLEEPER=""
shutdown() {
  [[ -n $SLEEPER ]] && kill "$SLEEPER" 2>/dev/null
  if check_controller; then
    log "stopping, setting fans to ${STOP_SPEED}%"
    for (( fan = 1; fan <= FAN_QUANTITY; fan++ )); do set_fan "$fan" "$STOP_SPEED"; done
  fi
  rm -f "$STATUS" "$IDENTIFY"
  exit 0
}

load_config
find_controller
log "started (controller ${NZXT:-not found yet}, interval ${INTERVAL}s, drive temp: $HDD_TEMP_MODE)"
trap shutdown TERM INT
trap 'load_config; log "config reloaded"' HUP
trap ':' USR1   # wake up now, e.g. for an identify request

while true; do
  tick
  wait_for=$INTERVAL
  read -r _ id_left <<< "$(identify_active)"
  [[ -n $id_left ]] && (( id_left < wait_for )) && wait_for=$id_left
  sleep "$wait_for" &
  SLEEPER=$!
  wait "$SLEEPER"
  kill "$SLEEPER" 2>/dev/null
  SLEEPER=""
done
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/rc.&name;" Mode="0755">
<INLINE><![CDATA[#!/bin/bash
# start|stop|restart|apply|reload|identify|watchdog|status for the NZXT fan control daemon.

PLUGIN=nzxt-fancontrol
DAEMON=/usr/local/emhttp/plugins/$PLUGIN/scripts/fancontrol.sh
PIDFILE=/var/run/$PLUGIN.pid
IDENTIFY=/var/run/$PLUGIN.identify
CFG=/boot/config/plugins/$PLUGIN/$PLUGIN.cfg
IDENTIFY_SECONDS=10

running() { [[ -f $PIDFILE ]] && kill -0 "$(< "$PIDFILE")" 2>/dev/null; }

enabled() {
  local SERVICE=enable
  [[ -f $CFG ]] && source "$CFG"
  [[ $SERVICE == enable ]]
}

start() {
  running && { echo "$PLUGIN already running"; return 0; }
  setsid "$DAEMON" </dev/null >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  running && echo "$PLUGIN started" || { echo "$PLUGIN failed to start (see syslog)"; rm -f "$PIDFILE"; return 1; }
}

stop() {
  running || { rm -f "$PIDFILE"; echo "$PLUGIN not running"; return 0; }
  local pid; pid=$(< "$PIDFILE")
  kill "$pid"
  for _ in {1..10}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
  rm -f "$PIDFILE"
  echo "$PLUGIN stopped"
}

# Called by the settings page after saving. Reloads in place so the fans don't blip to the safe speed.
apply() {
  if ! enabled; then stop
  elif running; then kill -HUP "$(< "$PIDFILE")"; echo "$PLUGIN settings reloaded"
  else start
  fi
}

identify() {
  [[ $1 =~ ^[1-3]$ ]] || { echo "usage: $0 identify 1|2|3"; return 1; }
  running || { echo "$PLUGIN is not running"; return 1; }
  echo "$1 $(( $(date +%s) + IDENTIFY_SECONDS ))" > "$IDENTIFY"
  kill -USR1 "$(< "$PIDFILE")"
  echo "fan $1 at 100% for ${IDENTIFY_SECONDS}s"
}

# Run from cron: restarts the daemon if it died while the service is enabled.
watchdog() {
  enabled && ! running || return 0
  local NOTIFY=yes
  [[ -f $CFG ]] && source "$CFG"
  logger -t "$PLUGIN" "watchdog: daemon was not running, restarting"
  [[ $NOTIFY == yes ]] && /usr/local/emhttp/webGui/scripts/notify -e "NZXT Fan Control" -i warning -s "Fan control restarted" \
    -d "The fan control daemon had stopped and was restarted by the watchdog." >/dev/null 2>&1
  start
}

case $1 in
  start)    start ;;
  stop)     stop ;;
  restart)  stop; start ;;
  apply)    apply ;;
  reload)   running && kill -HUP "$(< "$PIDFILE")" ;;
  identify) identify "$2" ;;
  watchdog) watchdog ;;
  status)   running && echo "$PLUGIN running (pid $(< "$PIDFILE"))" || { echo "$PLUGIN stopped"; exit 1; } ;;
  *)        echo "usage: $0 start|stop|restart|apply|reload|identify <fan>|watchdog|status"; exit 1 ;;
esac
]]></INLINE>
</FILE>

