Menu="Dashboard:0"
Cond="(@parse_ini_file('/boot/config/plugins/nzxt-fancontrol/nzxt-fancontrol.cfg')['DASHBOARD'] ?? 'airflow') != 'no'"
---
<?PHP
$pluginname = "nzxt-fancontrol";
$dashMode = @parse_ini_file("/boot/config/plugins/$pluginname/$pluginname.cfg")['DASHBOARD'] ?? 'airflow';

// Position of the NZXT fans in Unraid's Airflow tile, which numbers every fanN_input from `sensors` in order.
$airflowOffset = -1; $airflowTotal = 0;
if ($dashMode != 'tile') {
  $index = 0; $chip = '';
  foreach (explode("\n", shell_exec("sensors -uA 2>/dev/null")) as $line) {
    if ($line !== '' && $line[0] != ' ' && strpos($line, ':') === false) $chip = $line;
    elseif (preg_match('/^\s+fan\d+_input:/', $line)) {
      if ($airflowOffset < 0 && strpos($chip, 'nzxtsmart2') === 0) $airflowOffset = $index;
      $index++;
    }
  }
  $airflowTotal = $index;
}

// Own tile only when there is no Airflow tile to extend (or it was asked for).
if ($airflowOffset < 0) {
$mytiles[$pluginname]['column2'] =
<<<EOT
<tbody id="nzdash" title="_(NZXT Fan Control)_">
<tr>
  <td>
    <span class='tile-header'>
      <span class='tile-header-left'>
        <i class='icon-fan f32'></i>
        <div class='section'>
          <h3 class='tile-header-main'>_(Fans)_</h3>
          <span id='nzdash-state'>_(Loading)_...</span><br>
        </div>
      </span>
      <span class='tile-header-right'>
        <span class='tile-header-right-controls'>
          <a href="/Settings/NZXTFanControl" title="_(Fan control settings)_"><i class="fa fa-fw fa-cog control"></i></a>
        </span>
      </span>
    </span>
  </td>
</tr>
<tr><td id="nzdash-fans"></td></tr>
</tbody>
EOT;
}
?>
<style>
#nzdash-fans .nzd-row{display:grid;grid-template-columns:minmax(0,1fr) 3.5em 7em 5em;align-items:center;gap:8px;padding:3px 0;font-variant-numeric:tabular-nums}
#nzdash-fans .nzd-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#nzdash-fans .nzd-bar{position:relative;height:14px;border-radius:3px;background:rgba(128,128,128,.2);overflow:hidden}
#nzdash-fans .nzd-bar span{position:absolute;inset:0 auto 0 0;background:#3987e5;border-radius:3px}
#nzdash-fans .nzd-bar b{position:relative;display:block;text-align:center;font-size:11px;line-height:14px;font-weight:normal}
#nzdash-fans .nzd-rpm,#nzdash-fans .nzd-temp{text-align:right}
#nzdash-fans .nzd-note{grid-column:1/-1;opacity:.75;font-size:.9em;margin-top:-2px}
</style>
<script>
var nzAirflowOffset = <?=$airflowOffset?>, nzAirflowTotal = <?=$airflowTotal?>, nzFanCount = 3;

// Moves the NZXT fans into Unraid's Airflow tile: our rows replace its plain "FAN n / RPM" entries.
function nzAirflowSetup() {
  if ($('#nzdash-fans').length) return true;
  var first = $('#fan' + nzAirflowOffset);
  if (!first.length) return false;
  var td = first.closest('td'), tbody = first.closest('tbody');
  if (nzAirflowTotal <= nzFanCount) {
    td.closest('tr').hide();   // every fan in the tile is ours
  } else {
    var labels = td.children('span:not([id])');
    for (var k = 0; k < nzFanCount; k++) { labels.eq(nzAirflowOffset + k).hide(); $('#fan' + (nzAirflowOffset + k)).hide(); }
  }
  td.closest('tr').after('<tr><td id="nzdash-fans"></td></tr>');
  tbody.find('.tile-header-left .section > span').first().append(' &middot; <span id="nzdash-state"></span>');
  var cog = '<a href="/Settings/NZXTFanControl" title="NZXT fan control settings"><i class="fa fa-fw fa-sliders control"></i></a>';
  var controls = tbody.find('.tile-header-right-controls');
  if (controls.length) controls.prepend(cog);
  else tbody.find('.tile-header').append('<span class="tile-header-right"><span class="tile-header-right-controls">' + cog + '</span></span>');
  return true;
}

function nzDashRefresh() {
  $.get('/plugins/nzxt-fancontrol/include/status.php', function(d) {
    nzFanCount = Math.max(d.fans.length, 1);
    if (nzAirflowOffset >= 0) nzAirflowSetup();
    var box = $('#nzdash-fans');
    if (!box.length) return;
    $('#nzdash-state').text(d.controller === 'missing' ? 'Controller missing' : (d.fans.length ? 'Running' : 'Stopped'));
    box.html(d.fans.map(function(f) {
      return '<div class="nzd-row"><span class="nzd-name" title="' + f.source + ', ' + f.mode + '">' + f.name + '</span>' +
        '<span class="nzd-temp">' + (f.temp === null ? '-' : f.temp + '&deg;C') + '</span>' +
        '<span class="nzd-bar"><span style="width:' + f.speed + '%"></span><b>' + f.speed + '%</b></span>' +
        '<span class="nzd-rpm">' + f.rpm + ' rpm</span>' +
        (f.note ? '<span class="nzd-note">' + f.note + '</span>' : '') + '</div>';
    }).join('') || '<span class="nzd-note">No data</span>');
  }, 'json');
}
$(function() {
  nzDashRefresh();
  setInterval(nzDashRefresh, 10000);
});
</script>
